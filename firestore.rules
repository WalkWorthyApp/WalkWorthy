rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // IMPORTANT: Admin SDK Bypass
    // Cloud Functions use the Admin SDK which BYPASSES these Firestore rules.
    // Rules only protect client-side reads/writes via SDKs (web, mobile, REST).
    // Therefore, this ruleset supplements (not replaces) application-level validation:
    // - Application code MUST hash tokens before storage (see shared/crypto.ts)
    // - Application code MUST validate token format (see shared/crypto.ts)
    // - Application code MUST implement TTL/rotation (90-day policy)
    // - Application code MUST redact tokens from logs (see shared/crypto.ts)

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles - owner can READ; writes go through Cloud Functions only.
    // SECURITY: Profile writes are owned server-side by functions/src/api/user-profile.ts
    // using the Admin SDK (which bypasses rules). Closing client writes entirely
    // eliminates the arbitrary-field / arbitrary-subcollection write vector.
    match /users/{userId}/profile/data {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/profile/{rest=**} {
      allow read, write: if false;
    }

    // Device registrations - push-notification token storage. The feature has
    // not shipped (no registerDevice endpoint, no iOS caller), so client access
    // is closed until it does. This was the only client-writable path in the
    // ruleset, which made it a free doc-creation surface protecting nothing.
    // The validated create/update ruleset (hashed-token allowlist, timestamp
    // freshness, field immutability) plus its isRecentIso/containsSensitiveFields
    // helpers are preserved in git history and specified in
    // functions/NOTIFICATION_TOKEN_SECURITY.md - restore from there when the
    // feature ships.
    match /users/{userId}/devices/{deviceId} {
      allow read, write: if false;
    }

    // Per-user encouragements (all encouragement reads/writes go through this path).
    // Cloud Functions create/update these via Admin SDK (bypasses rules).
    // NOTE: The top-level /encouragements/{id} collection is intentionally NOT exposed:
    // no code reads or writes it, and the catch-all deny at the bottom covers it.
    // This removes the prior global-enumeration vector for any signed-in user.
    match /users/{userId}/encouragements/{encouragementId} {
      allow read: if isOwner(userId);
      allow write: if false; // Only Cloud Functions can write
    }

    // Mood Check-ins - users can read their own mood data
    // Cloud Functions create these via Admin SDK when user submits a check-in
    match /users/{userId}/moodCheckIns/{checkInId} {
      allow read: if isOwner(userId);
      allow write: if false; // Only Cloud Functions can write
    }

    // Daily Mood Summaries - aggregated mood data per day
    match /users/{userId}/moodSummaries/{date} {
      allow read: if isOwner(userId);
      allow write: if false; // Only Cloud Functions can write
    }

    // Daily Reflections - AI-generated devotional prompts cached per day
    // Cloud Functions create these via Admin SDK
    match /users/{userId}/dailyReflections/{date} {
      allow read: if isOwner(userId);
      allow write: if false; // Only Cloud Functions can write
    }

    // Journal Entries - users can read their own journal data
    // Cloud Functions create/update/delete these via Admin SDK
    match /users/{userId}/journalEntries/{entryId} {
      allow read: if isOwner(userId);
      allow write: if false; // Only Cloud Functions can write
    }

    // Internal rate-limiting and budget tracking (Cloud Functions only via Admin SDK)
    match /_rateLimits/{document=**} {
      allow read, write: if false;
    }
    match /_dailyBudgets/{document=**} {
      allow read, write: if false;
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}